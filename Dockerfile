# ==============================================================================
# 选做 O1 使用的 Dockerfile
# 
# 核心设计：镜像里不重新编译，直接放入 CI 已经构建好的二进制
# 这样镜像里跑的就是制品里的那个文件，符合"build once, deploy many"原则
# （参考 L-05 第 11 页）
# ==============================================================================

# ------------------------------------------------------------------------------
# FROM scratch：最小化基础镜像
# 
# scratch 是一个特殊的空白镜像，里面什么都没有（0MB）
# 优点：镜像极小、攻击面小、启动快
# 缺点：没有 shell，不能 docker exec -it xxx sh 进入调试
# 
# Go 编译的二进制是静态链接的，不依赖系统库，所以可以直接放在 scratch 里运行
# ------------------------------------------------------------------------------
FROM scratch

# ------------------------------------------------------------------------------
# 构建参数（build-args）
# 这些值在 docker build 时通过 --build-arg 传入
# 用于设置镜像的 OCI 标签（元数据）
# ------------------------------------------------------------------------------
ARG VERSION=dev          # 版本号，如 1.0.1
ARG COMMIT=unknown       # Git 提交号，用于追溯源码
ARG SOURCE=              # 源码仓库地址

# ------------------------------------------------------------------------------
# OCI 标签（镜像元数据）
# 
# org.opencontainers.image.source 标签让 GitHub Container Registry 
# 自动把镜像关联到对应的仓库，在 Packages 页面显示关联关系
# 
# 这些标签可以通过 docker inspect 查看
# ------------------------------------------------------------------------------
LABEL org.opencontainers.image.version=$VERSION \
      org.opencontainers.image.revision=$COMMIT \
      org.opencontainers.image.source=$SOURCE

# ------------------------------------------------------------------------------
# 复制文件到镜像
# 
# 构建上下文是解压后的 Release 附件目录（不是仓库根目录）
# 例如：image-context/build/ 下有 enroll-conflict 和 BUILD_INFO
# 
# 关键：这里复制的是已经构建好的二进制，不在 Dockerfile 里重新编译！
# ------------------------------------------------------------------------------
COPY enroll-conflict /enroll-conflict    # 复制可执行二进制
COPY BUILD_INFO /BUILD_INFO              # 复制版本信息文件

# ------------------------------------------------------------------------------
# 暴露端口
# 声明容器运行时监听 8080 端口（实际绑定需要 docker run -p）
# ------------------------------------------------------------------------------
EXPOSE 8080

# ------------------------------------------------------------------------------
# 以非 root 用户运行（安全最佳实践）
# 
# 65532:65532 是一个常用的非特权用户 ID
# 即使容器被攻破，攻击者也没有 root 权限
# ------------------------------------------------------------------------------
USER 65532:65532

# ------------------------------------------------------------------------------
# 容器启动命令
# 
# ENTRYPOINT 指定容器启动时执行的命令
# 使用 exec 格式（JSON 数组），而不是 shell 格式
# 这样信号能正确传递给进程，优雅关闭
# ------------------------------------------------------------------------------
ENTRYPOINT ["/enroll-conflict"]
